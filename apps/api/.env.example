# SIMK API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT (short-lived access token)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=5m

# Opaque refresh token TTL (seconds) — hashed and stored in the DB
REFRESH_TOKEN_TTL_SECONDS=604800

# Initial admin user (seeded on startup when no admin exists)
ADMIN_EMAIL=admin@simk.dev
ADMIN_PASSWORD=password123
ADMIN_NAME=Admin

# Postgres (Drizzle)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=simk
DB_SSL=false

# Redis (cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# SatuSehat (FHIR R4) — leave empty to disable integration in local dev
SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id/fhir-r4/v1
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
SATUSEHAT_AUTH_URL=https://api-satusehat.kemkes.go.id/oauth2/v1
